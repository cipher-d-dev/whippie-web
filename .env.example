# ─────────────────────────────────────────────
#  Whippe — Environment Variable Reference
#  Copy this file to .env in each app and fill
#  in real values. Never commit real .env files.
# ─────────────────────────────────────────────

# ── API (apps/api) ──────────────────────────
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/whippe?retryWrites=true&w=majority

# Session secret — use a long random string in production
SESSION_SECRET=change_me_to_a_long_random_secret

# CORS — space-separated allowed origins
CORS_ORIGINS=http://localhost:3000 http://localhost:3001

# Object storage (S3-compatible)
OBJECT_STORAGE_ENDPOINT=https://s3.example.com
OBJECT_STORAGE_BUCKET=whippe-documents
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=auto

# ── Web (apps/web) ───────────────────────────
# Must start with NEXT_PUBLIC_ to be available in the browser.
# Never put database credentials or server secrets here.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Intern PWA (apps/intern-pwa) ─────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
