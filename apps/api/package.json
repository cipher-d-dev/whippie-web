    "express": "4.19.2",
    "express-session": "1.18.0",
    "mongoose": "8.5.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.7",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/express-session": "1.18.0",
    "@types/node": "20.14.11",
    "eslint": "8.57.0",
    "@typescript-eslint/eslint-plugin": "7.17.0",
    "@typescript-eslint/parser": "7.17.0",
    "tsx": "4.16.2",
    "typescript": "5.5.4"
